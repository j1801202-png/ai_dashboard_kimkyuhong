# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# 배포 URL (로컬: http://localhost:3000 / Railway: Railway 도메인)
BASE_URL=http://localhost:3000

# PostgreSQL (Railway에서 자동 제공)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 세션 시크릿 (랜덤 문자열)
SESSION_SECRET=your-random-secret-key-change-this

# 관리자 이메일 (쉼표 구분, 첫 로그인 시 자동 admin 권한)
ADMIN_EMAILS=admin@gmail.com

# Gmail 자동 발송 (Gmail 2단계 인증 후 앱 비밀번호 사용)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-16-chars

# 일일 결산 발송 시간 (cron 형식, 기본: 매일 오후 5시)
EMAIL_CRON=0 17 * * *

# 환경
NODE_ENV=production
PORT=3000
